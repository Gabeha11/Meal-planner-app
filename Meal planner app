                recipe,
                coverage:
                    getRecipeCoverage(
                        recipe,
                        recipe.servings
                    )
            }))
            .sort(
                (a, b) =>
                    b.coverage.percentage -
                    a.coverage.percentage
            );

    const container =
        document.getElementById(
            "canMakeResults"
        );

    container.innerHTML =
        meals.map(item => {

            const missing =
                getMissingIngredientsForRecipe(
                    item.recipe,
                    item.recipe.servings
                );

            let badge = "badge-red";

            if (item.coverage.percentage === 100) {
                badge = "badge-green";
            } else if (
