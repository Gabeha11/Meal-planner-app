function addInventoryItem() {

    const name =
        document.getElementById(
            "newInventoryName"
        ).value.trim();

    if (!name) {
        alert("Enter an item name.");
        return;
    }

    const qty =
        Number(
            document.getElementById(
                "newInventoryQty"
            ).value
        ) || 0;

    const unit =
        document.getElementById(
            "newInventoryUnit"
        ).value.trim() || "each";

    const location =
        document.getElementById(
            "newInventoryLocation"
        ).value;

    const existing =
        findInventoryItem(name, unit);

    if (existing) {

        existing.qty =
            Number(existing.qty) + qty;

    } else {

        state.inventory.push({
            id: uid(),
            name,
            qty,
            unit,
            location
        });

    }

    document.getElementById(
        "newInventoryName"
    ).value = "";

    document.getElementById(
        "newInventoryQty"
    ).value = 1;

    document.getElementById(
        "newInventoryUnit"
    ).value = "";

    saveState();
    renderAll();

}


function updateInventory(
    id,
    field,
    value
) {

    const item =
        state.inventory.find(
            item => item.id === id
        );

    if (!item) return;

    if (field === "qty") {
        item[field] = Math.max(
            0,
            Number(value) || 0
        );
    } else {
        item[field] = value;
    }

    saveState();
    renderAll();

}


function adjustInventoryQty(
    id,
    amount
) {

    const item =
        state.inventory.find(
            item => item.id === id
        );

    if (!item) return;

    item.qty =
        Math.max(
            0,
            roundQty(
                Number(item.qty) +
                amount
            )
        );

    saveState();
    renderAll();

}


function deleteInventoryItem(id) {

    state.inventory =
        state.inventory.filter(
            item => item.id !== id
        );

    saveState();
    renderAll();

}


