============================================================ */

function showPage(pageId, clickedButton) {

    document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
    });

    document.getElementById(pageId).classList.add("active");

    document.querySelectorAll(".nav-btn").forEach(btn => {
        btn.classList.remove("active");
    });

    if (clickedButton) {
        clickedButton.classList.add("active");
    }

    renderAll();

}


/* ============================================================
   INVENTORY HELPERS
============================================================ */

function findInventoryItem(name, unit) {

    const normalized = normalizeName(name);
    const normalizedUnit = normalizeName(unit);

    return state.inventory.find(item =>
        normalizeName(item.name) === normalized &&
        normalizeName(item.unit) === normalizedUnit
    );

}


function getInventoryQuantity(name, unit) {

    const item = findInventoryItem(name, unit);

    return item
        ? Number(item.qty) || 0
        : 0;

}


function ingredientAvailability(ingredient, scale = 1) {

    const required = Number(ingredient.qty) * scale;

    const available = getInventoryQuantity(
        ingredient.name,
        ingredient.unit
    );

    return {
        required,
        available,
        missing: Math.max(0, required - available)
    };

}


/* ============================================================
   TONIGHT
============================================================ */

function getTonightMainRecipe() {

    return state.recipes.find(
        recipe => recipe.id === state.tonight.mainRecipeId
    );

}


function getTonightSideRecipes() {

    return state.tonight.sides
        .map(id => state.recipes.find(r => r.id === id))
        .filter(Boolean);

}


function chooseTonightMeal(recipeId) {

    const recipe = state.recipes.find(r => r.id === recipeId);

    if (!recipe) return;

    state.tonight.mainRecipeId = recipeId;

    state.tonight.servings =
        Number(recipe.servings) || 4;

    state.tonight.sides = [];

    saveState();

    renderAll();

    showPage(
        "tonight",
        document.querySelector('[data-page="tonight"]')
    );

}


function setTonightServings(value) {

    const servings = Math.max(1, Number(value) || 1);

    state.tonight.servings = servings;

    saveState();

    renderAll();

}


function addSideToTonight(sideId) {

    if (!state.tonight.sides.includes(sideId)) {
        state.tonight.sides.push(sideId);
    }

    saveState();
    renderAll();

}


function removeSideFromTonight(sideId) {

    state.tonight.sides =
        state.tonight.sides.filter(id => id !== sideId);

    saveState();
    renderAll();

}


function getRecipeCoverage(recipe, servings = null) {

    const desiredServings =
        servings || recipe.servings || 1;

    const scale =
        desiredServings / (recipe.servings || 1);

    let requiredTotal = 0;
    let availableTotal = 0;
    let completelyAvailable = 0;

    recipe.ingredients.forEach(ingredient => {

        const availability =
            ingredientAvailability(ingredient, scale);

        const required = availability.required;

        if (required <= 0) return;

        requiredTotal++;

        if (availability.missing <= 0.001) {
            completelyAvailable++;
        }

        availableTotal += Math.min(
            1,
            availability.available / required
        );

    });

    const percentage = requiredTotal
        ? Math.round((availableTotal / requiredTotal) * 100)
        : 100;

    return {
        percentage,
        completelyAvailable,
        total: requiredTotal
    };

}


function getSideSuggestions() {

    const sides = state.recipes.filter(
        recipe => recipe.type === "side"
    );

    return sides
        .map(side => {

            const coverage =
                getRecipeCoverage(
                    side,
                    state.tonight.servings
                );

            return {
                recipe: side,
                coverage
            };

        })
        .sort(
            (a, b) =>
                b.coverage.percentage -
                a.coverage.percentage
        );

}


