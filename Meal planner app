function saveRecipe() {

    const id =
        document.getElementById(
            "editingRecipeId"
        ).value || uid();

    const name =
        document.getElementById(
            "recipeName"
        ).value.trim();

    if (!name) {
        alert("Recipe name is required.");
        return;
    }

    const ingredientRows =
        [
            ...document.querySelectorAll(
                "#ingredientEditor .ingredient-row"
            )
        ];

    const ingredients =
        ingredientRows
            .map(row => ({
                name:
                    row.querySelector(
                        ".ingredient-name"
                    ).value.trim(),

                qty:
                    Number(
                        row.querySelector(
                            ".ingredient-qty"
                        ).value
                    ) || 0,

                unit:
                    row.querySelector(
                        ".ingredient-unit"
                    ).value.trim()
            }))
            .filter(
                ingredient =>
                    ingredient.name
            );

    const stepRows =
        [
            ...document.querySelectorAll(
                "#stepEditor .step-row"
            )
        ];

    const steps =
        stepRows
            .map(row => ({
                text:
                    row.querySelector(
                        ".step-text"
                    ).value.trim(),

                minutes:
                    Number(
                        row.querySelector(
                            ".step-minutes"
                        ).value
                    ) || 0
            }))
            .filter(step => step.text);

    const recipe = {

        id,

        name,

        type:
            document.getElementById(
                "recipeType"
            ).value,

        servings:
            Math.max(
                1,
                Number(
                    document.getElementById(
                        "recipeServings"
                    ).value
                ) || 1
            ),

        cookTime:
            Math.max(
                0,
                Number(
                    document.getElementById(
                        "recipeCookTime"
                    ).value
                ) || 0
            ),

        notes:
            document.getElementById(
                "recipeNotes"
            ).value.trim(),

        ingredients,

        steps
    };

    const index =
        state.recipes.findIndex(
            r => r.id === id
        );

    if (index >= 0) {
        state.recipes[index] = recipe;
    } else {
        state.recipes.push(recipe);
    }

    saveState();

    closeModal("recipeModal");

    renderAll();

}


function deleteRecipe(recipeId) {

    const recipe =
        state.recipes.find(
            r => r.id === recipeId
        );

    if (!recipe) return;

    if (
        !confirm(
            `Delete "${recipe.name}"?`
        )
    ) {
        return;
    }

    state.recipes =
        state.recipes.filter(
            r => r.id !== recipeId
        );

    if (
        state.tonight.mainRecipeId ===
        recipeId
    ) {
        state.tonight.mainRecipeId = null;
    }

    state.tonight.sides =
        state.tonight.sides.filter(
            id => id !== recipeId
        );

    Object.keys(state.plan)
        .forEach(day => {

            if (
                state.plan[day]?.recipeId ===
                recipeId
            ) {
                delete state.plan[day];
            }

        });

    saveState();
    renderAll();

}


