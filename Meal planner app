function getMissingIngredientsForRecipe(
    recipe,
    servings
) {

    const scale =
        servings / (recipe.servings || 1);

    return recipe.ingredients
        .map(ingredient => {

            const result =
                ingredientAvailability(
                    ingredient,
                    scale
                );

            return {
                ...ingredient,
                ...result
            };

        })
        .filter(item => item.missing > 0.001);

}


