function renderSideSuggestions() {

    const container =
        document.getElementById("sideSuggestions");

    const main = getTonightMainRecipe();

    if (!main) return;

    const suggestions =
        getSideSuggestions()
            .filter(
                item =>
                    !state.tonight.sides.includes(
                        item.recipe.id
                    )
            )
            .slice(0, 6);

    if (!suggestions.length) {

        container.innerHTML = `
            <div class="empty-state">
                No additional side recipes found.
            </div>
        `;

        return;
    }

    container.innerHTML =
        suggestions.map(item => {

            const coverage =
                item.coverage.percentage;

            let badge = "badge-red";

            if (coverage >= 100) {
                badge = "badge-green";
            } else if (coverage >= 70) {
                badge = "badge-yellow";
            }

            return `
                <div class="side-card">

                    <div class="section-title">

                        <div>
                            <div class="side-title">
                                ${escapeHtml(item.recipe.name)}
                            </div>

                            <div class="muted">
                                ${item.recipe.cookTime || 0}
                                min
                            </div>
                        </div>

                        <span class="badge ${badge}">
                            ${coverage}% available
                        </span>

                    </div>

                    <button
                        class="btn btn-primary"
                        onclick="addSideToTonight('${item.recipe.id}')"
                    >
                        + Add Side
                    </button>

                </div>
            `;

        }).join("");

}


