/* ============================================================
   STATE
============================================================ */

function loadState() {

    const stored = localStorage.getItem("familyMealPlannerV3");

    if (stored) {

        try {

            const parsed = JSON.parse(stored);

            return {
                recipes: Array.isArray(parsed.recipes)
                    ? parsed.recipes
                    : structuredClone(defaultRecipes),

                inventory: Array.isArray(parsed.inventory)
                    ? parsed.inventory
                    : structuredClone(defaultInventory),

                tonight: parsed.tonight || {
                    mainRecipeId: null,
                    servings: 5,
                    sides: []
                },

                plan: parsed.plan || {},

                shoppingOverrides: parsed.shoppingOverrides || {},

                shoppingChecked: parsed.shoppingChecked || {}
            };

        } catch (error) {
            console.error(error);
        }

    }

    return {
        recipes: structuredClone(defaultRecipes),
        inventory: structuredClone(defaultInventory),
        tonight: {
            mainRecipeId: null,
            servings: 5,
            sides: []
        },
        plan: {},
        shoppingOverrides: {},
        shoppingChecked: {}
    };
}


let state = loadState();


function saveState() {

    localStorage.setItem(
        "familyMealPlannerV3",
        JSON.stringify(state)
    );

}


