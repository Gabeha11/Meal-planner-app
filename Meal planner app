<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Family Meal Planner</title>

<style>
:root {
    --bg: #f4f5f7;
    --card: #ffffff;
    --text: #1f2937;
    --muted: #6b7280;
    --border: #e5e7eb;
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --green: #16a34a;
    --green-light: #dcfce7;
    --yellow: #ca8a04;
    --yellow-light: #fef9c3;
    --red: #dc2626;
    --red-light: #fee2e2;
    --purple: #7c3aed;
    --shadow: 0 2px 8px rgba(0,0,0,.07);
    --radius: 14px;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

header {
    background: #111827;
    color: white;
    padding: 18px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}

header h1 {
    margin: 0;
    font-size: 24px;
}

header .small {
    color: #d1d5db;
}

nav {
    background: white;
    border-bottom: 1px solid var(--border);
    display: flex;
    overflow-x: auto;
    position: sticky;
    top: 0;
    z-index: 20;
}

nav button {
    background: none;
    border: none;
    padding: 16px 20px;
    font-weight: 700;
    color: var(--muted);
    border-bottom: 3px solid transparent;
    white-space: nowrap;
}

nav button.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
}

main {
    max-width: 1250px;
    margin: auto;
    padding: 22px;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

.card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow);
    margin-bottom: 18px;
}

.grid {
    display: grid;
    gap: 18px;
}

.grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.recipe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(285px, 1fr));
    gap: 16px;
}

h2,
h3,
h4 {
    margin-top: 0;
}

.muted {
    color: var(--muted);
}

.btn {
    border: none;
    border-radius: 9px;
    padding: 10px 14px;
    font-weight: 700;
}

.btn-primary {
    background: var(--primary);
    color: white;
}

.btn-primary:hover {
    background: var(--primary-dark);
}

.btn-green {
    background: var(--green);
    color: white;
}

.btn-red {
    background: var(--red);
    color: white;
}

.btn-light {
    background: #f3f4f6;
    color: #374151;
    border: 1px solid var(--border);
}

.btn-purple {
    background: var(--purple);
    color: white;
}

.btn-large {
    padding: 14px 22px;
    font-size: 16px;
}

.button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

input,
select,
textarea {
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 10px;
    background: white;
    color: var(--text);
    width: 100%;
}

textarea {
    resize: vertical;
    min-height: 85px;
}

label {
    font-weight: 700;
    display: block;
    margin-bottom: 5px;
}

.field {
    margin-bottom: 14px;
}

.form-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    align-items: end;
}

.recipe-card {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.recipe-card .recipe-title {
    font-size: 19px;
    font-weight: 800;
    margin-bottom: 5px;
}

.recipe-meta {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 12px;
}

.recipe-card .button-row {
    margin-top: auto;
}

.badge {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
}

.badge-green {
    color: #166534;
    background: var(--green-light);
}

.badge-yellow {
    color: #854d0e;
    background: var(--yellow-light);
}

.badge-red {
    color: #991b1b;
    background: var(--red-light);
}

.badge-purple {
    color: #6d28d9;
    background: #ede9fe;
}

.hero {
    padding: 26px;
}

.hero h2 {
    font-size: 28px;
    margin-bottom: 5px;
}

.hero-meal-name {
    font-size: 32px;
    font-weight: 900;
    margin: 12px 0 4px;
}

.progress {
    height: 10px;
    background: #e5e7eb;
    border-radius: 20px;
    overflow: hidden;
}

.progress div {
    height: 100%;
    background: var(--green);
}

.inventory-row,
.shopping-row,
.ingredient-row,
.step-row {
    display: grid;
    gap: 10px;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding: 10px 0;
}

.inventory-row {
    grid-template-columns: 2fr 100px 120px 140px auto;
}

.shopping-row {
    grid-template-columns: 42px 2fr 110px 120px auto;
}

.ingredient-row {
    grid-template-columns: 2fr 100px 120px auto;
}

.step-row {
    grid-template-columns: 1fr 100px auto;
}

.quantity-control {
    display: flex;
    align-items: center;
    gap: 6px;
}

.quantity-control button {
    width: 34px;
    height: 34px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: #f9fafb;
    font-weight: 900;
}

.quantity-control input {
    min-width: 70px;
}

.side-card {
    border: 1px solid var(--border);
    border-radius: 11px;
    padding: 14px;
    margin-bottom: 10px;
}

.side-title {
    font-weight: 800;
    font-size: 17px;
}

.missing-item {
    color: var(--red);
    font-weight: 700;
}

.available-item {
    color: var(--green);
    font-weight: 700;
}

.day-card {
    min-height: 180px;
}

.day-name {
    font-size: 18px;
    font-weight: 900;
    margin-bottom: 12px;
}

.plan-meal {
    margin-top: 10px;
    padding: 10px;
    border-radius: 9px;
    background: #f3f4f6;
}

.modal {
    display: none;
    position: fixed;
    z-index: 100;
    inset: 0;
    background: rgba(0,0,0,.55);
    padding: 20px;
    overflow-y: auto;
}

.modal.open {
    display: block;
}

.modal-content {
    max-width: 850px;
    margin: 20px auto;
    background: white;
    border-radius: 16px;
    padding: 22px;
    box-shadow: 0 10px 40px rgba(0,0,0,.2);
}

.modal-large {
    max-width: 1050px;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
}

.close-btn {
    background: #f3f4f6;
    border: none;
    border-radius: 50%;
    width: 38px;
    height: 38px;
    font-size: 20px;
}

.cook-step {
    padding: 16px;
    border-left: 4px solid var(--primary);
    background: #f9fafb;
    margin-bottom: 12px;
    border-radius: 0 10px 10px 0;
}

.cook-time {
    font-weight: 900;
    color: var(--primary);
    margin-bottom: 4px;
}

.empty-state {
    text-align: center;
    padding: 35px;
    color: var(--muted);
}

.search-bar {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
}

.ready-score {
    font-size: 26px;
    font-weight: 900;
}

.section-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.section-title h2,
.section-title h3 {
    margin: 0;
}

.summary-box {
    background: #f9fafb;
    border-radius: 10px;
    padding: 14px;
}

hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 20px 0;
}

@media (max-width: 850px) {
    .grid-2,
    .grid-3,
    .form-row {
        grid-template-columns: 1fr;
    }

    .inventory-row,
    .shopping-row,
    .ingredient-row,
    .step-row {
        grid-template-columns: 1fr;
    }

    .shopping-row {
        position: relative;
        padding-left: 45px;
    }

    .shopping-row > input[type="checkbox"] {
        position: absolute;
        left: 0;
        top: 16px;
        width: 25px;
    }

    header {
        align-items: flex-start;
        flex-direction: column;
    }
}
</style>
</head>

<body>

<header>
    <div>
        <h1>Family Meal Planner</h1>
        <div class="small">Meals, inventory and shopping in one place</div>
    </div>

    <div class="button-row">
        <button class="btn btn-light" onclick="exportData()">Backup Data</button>
        <button class="btn btn-light" onclick="document.getElementById('importFile').click()">Restore Data</button>
        <input type="file" id="importFile" hidden accept=".json" onchange="importData(event)">
    </div>
</header>

<nav>
    <button class="nav-btn active" data-page="tonight" onclick="showPage('tonight', this)">Tonight</button>
    <button class="nav-btn" data-page="meals" onclick="showPage('meals', this)">Meals</button>
    <button class="nav-btn" data-page="inventory" onclick="showPage('inventory', this)">Inventory</button>
    <button class="nav-btn" data-page="shopping" onclick="showPage('shopping', this)">Shopping</button>
    <button class="nav-btn" data-page="plan" onclick="showPage('plan', this)">Plan</button>
</nav>

<main>

<!-- ========================================================= -->
<!-- TONIGHT -->
<!-- ========================================================= -->

<section id="tonight" class="page active">

    <div id="tonightHero"></div>

    <div class="grid grid-2">

        <div class="card">
            <div class="section-title">
                <h3>Suggested Sides</h3>
            </div>

            <div id="sideSuggestions"></div>
        </div>

        <div class="card">
            <div class="section-title">
                <h3>What Can We Make?</h3>
            </div>

            <p class="muted">
                Recipes are ranked using your current inventory.
            </p>

            <button class="btn btn-purple" onclick="openCanMakeModal()">
                Find Meals
            </button>
        </div>

    </div>

</section>


<!-- ========================================================= -->
<!-- MEALS -->
<!-- ========================================================= -->

<section id="meals" class="page">

    <div class="card">

        <div class="section-title">
            <h2>Meals & Recipes</h2>

            <button class="btn btn-primary" onclick="openRecipeEditor()">
                + Add Recipe
            </button>
        </div>

        <div class="search-bar">
            <input
                id="recipeSearch"
                type="text"
                placeholder="Search recipes..."
                oninput="renderRecipes()"
            >

            <select id="recipeFilter" onchange="renderRecipes()">
                <option value="all">All</option>
                <option value="meal">Main Meals</option>
                <option value="side">Sides</option>
            </select>
        </div>

    </div>

    <div id="recipeGrid" class="recipe-grid"></div>

</section>


<!-- ========================================================= -->
<!-- INVENTORY -->
<!-- ========================================================= -->

<section id="inventory" class="page">

    <div class="card">

        <div class="section-title">
            <h2>Inventory</h2>

            <button class="btn btn-primary" onclick="addInventoryItem()">
                + Add Item
            </button>
        </div>

        <div class="form-row">

            <div>
                <label>Item</label>
                <input id="newInventoryName" placeholder="Chicken breast">
            </div>

            <div>
                <label>Quantity</label>
                <input id="newInventoryQty" type="number" step="0.01" value="1">
            </div>

            <div>
                <label>Unit</label>
                <input id="newInventoryUnit" placeholder="lb">
            </div>

            <div>
                <label>Location</label>

                <select id="newInventoryLocation">
                    <option>Pantry</option>
                    <option>Refrigerator</option>
                    <option>Freezer</option>
                    <option>Other</option>
                </select>
            </div>

        </div>

    </div>

    <div class="card">
        <div id="inventoryList"></div>
    </div>

</section>


<!-- ========================================================= -->
<!-- SHOPPING -->
<!-- ========================================================= -->

<section id="shopping" class="page">

    <div class="card">

        <div class="section-title">
            <div>
                <h2>Shopping List</h2>
                <div class="muted">
                    Automatically calculated from planned meals and inventory.
                </div>
            </div>

            <div class="button-row">

                <button class="btn btn-light" onclick="clearShoppingOverrides()">
                    Reset Quantities
                </button>

                <button class="btn btn-green" onclick="addPurchasedToInventory()">
                    Add Purchased Items to Inventory
                </button>

            </div>
        </div>

    </div>

    <div class="card">

        <div id="shoppingList"></div>

    </div>

</section>


<!-- ========================================================= -->
<!-- PLAN -->
<!-- ========================================================= -->

<section id="plan" class="page">

    <div class="card">

        <div class="section-title">

            <div>
                <h2>Weekly Meal Plan</h2>
                <div class="muted">
                    Shopping quantities update automatically.
                </div>
            </div>

            <button class="btn btn-red" onclick="clearPlan()">
                Clear Week
            </button>

        </div>

    </div>

    <div id="weeklyPlan" class="grid grid-3"></div>

</section>

</main>


<!-- ========================================================= -->
<!-- RECIPE EDITOR -->
<!-- ========================================================= -->

<div id="recipeModal" class="modal">

<div class="modal-content modal-large">

    <div class="modal-header">

        <h2 id="recipeModalTitle">Recipe</h2>

        <button class="close-btn" onclick="closeModal('recipeModal')">×</button>

    </div>

    <input type="hidden" id="editingRecipeId">

    <div class="grid grid-2">

        <div class="field">
            <label>Recipe Name</label>
            <input id="recipeName">
        </div>

        <div class="field">
            <label>Type</label>

            <select id="recipeType">
                <option value="meal">Main Meal</option>
                <option value="side">Side</option>
            </select>
        </div>

        <div class="field">
            <label>Base Servings</label>
            <input id="recipeServings" type="number" min="1" value="4">
        </div>

        <div class="field">
            <label>Estimated Cooking Time (minutes)</label>
            <input id="recipeCookTime" type="number" min="0" value="30">
        </div>

    </div>

    <div class="field">
        <label>Notes</label>
        <textarea
            id="recipeNotes"
            placeholder="Family preferences, substitutions, special instructions..."
        ></textarea>
    </div>

    <hr>

    <div class="section-title">

        <h3>Ingredients</h3>

        <button class="btn btn-light" onclick="addIngredientEditorRow()">
            + Ingredient
        </button>

    </div>

    <div id="ingredientEditor"></div>

    <hr>

    <div class="section-title">

        <h3>Instructions</h3>

        <button class="btn btn-light" onclick="addStepEditorRow()">
            + Step
        </button>

    </div>

    <p class="muted">
        Step minutes help build the combined cooking timeline when sides are added.
    </p>

    <div id="stepEditor"></div>

    <hr>

    <div class="button-row">

        <button class="btn btn-primary btn-large" onclick="saveRecipe()">
            Save Recipe
        </button>

        <button class="btn btn-light btn-large" onclick="closeModal('recipeModal')">
            Cancel
        </button>

    </div>

</div>

</div>


<!-- ========================================================= -->
<!-- RECIPE VIEW -->
<!-- ========================================================= -->

<div id="viewRecipeModal" class="modal">

<div class="modal-content">

    <div class="modal-header">

        <h2 id="viewRecipeTitle"></h2>

        <button class="close-btn" onclick="closeModal('viewRecipeModal')">×</button>

    </div>

    <div id="viewRecipeContent"></div>

</div>

</div>


<!-- ========================================================= -->
<!-- WHAT CAN WE MAKE -->
<!-- ========================================================= -->

<div id="canMakeModal" class="modal">

<div class="modal-content">

    <div class="modal-header">

        <h2>What Can We Make?</h2>

        <button class="close-btn" onclick="closeModal('canMakeModal')">×</button>

    </div>

    <div id="canMakeResults"></div>

</div>

</div>


<!-- ========================================================= -->
<!-- COOK MODE -->
<!-- ========================================================= -->

<div id="cookModal" class="modal">

<div class="modal-content">

    <div class="modal-header">

        <h2>Cooking Mode</h2>

        <button class="close-btn" onclick="closeModal('cookModal')">×</button>

    </div>

    <div id="cookContent"></div>

</div>

</div>


<script>

/* ============================================================
   UTILITIES
============================================================ */

function uid() {
    return Date.now().toString(36) + Math.random().toString(36).substr(2, 6);
}

function normalizeName(name) {
    return String(name || "")
        .trim()
        .toLowerCase()
        .replace(/\s+/g, " ");
}

function roundQty(num) {
    num = Number(num) || 0;

    if (Math.abs(num - Math.round(num)) < 0.001) {
        return Math.round(num);
    }

    return Math.round(num * 100) / 100;
}

function escapeHtml(text) {

    const div = document.createElement("div");

    div.textContent = text ?? "";

    return div.innerHTML;
}

function openModal(id) {
    document.getElementById(id).classList.add("open");
}

function closeModal(id) {
    document.getElementById(id).classList.remove("open");
}

window.onclick = function(event) {

    if (event.target.classList.contains("modal")) {
        event.target.classList.remove("open");
    }

};


