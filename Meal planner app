/* ============================================================
   SHOPPING LIST
============================================================ */

function buildRequiredIngredients() {

    const totals = {};

    function addRecipe(
        recipe,
        servings
    ) {

        if (!recipe) return;

        const scale =
            servings /
            (recipe.servings || 1);

        recipe.ingredients.forEach(
            ingredient => {

                const key =
                    normalizeName(
                        ingredient.name
                    ) +
                    "|" +
                    normalizeName(
                        ingredient.unit
                    );

                if (!totals[key]) {

                    totals[key] = {
                        name:
                            ingredient.name,

                        unit:
                            ingredient.unit,

                        qty: 0
                    };

                }

                totals[key].qty +=
                    Number(ingredient.qty) *
                    scale;

            }
        );

    }

    Object.values(state.plan)
        .forEach(planned => {

            const recipe =
                state.recipes.find(
                    r =>
                        r.id ===
                        planned.recipeId
                );

            addRecipe(
                recipe,
                planned.servings ||
                recipe?.servings ||
                1
            );

        });

    /*
       Include tonight's meal if it is not already represented
       in the weekly plan with the same recipe.
    */

    const tonightMain =
        getTonightMainRecipe();

    const tonightAlreadyPlanned =
        tonightMain &&
        Object.values(state.plan)
            .some(
                planned =>
                    planned.recipeId ===
                    tonightMain.id
            );

    if (
        tonightMain &&
        !tonightAlreadyPlanned
    ) {

        addRecipe(
            tonightMain,
            state.tonight.servings
        );

    }

    getTonightSideRecipes()
        .forEach(side => {

            addRecipe(
                side,
                state.tonight.servings
            );

        });

    return totals;

}


function calculateShoppingList() {

    const required =
        buildRequiredIngredients();

    return Object.entries(required)
        .map(([key, item]) => {

            const inventoryQty =
                getInventoryQuantity(
                    item.name,
                    item.unit
                );

            const automaticallyNeeded =
                Math.max(
                    0,
                    item.qty -
                    inventoryQty
                );

            const finalQty =
                Object.prototype
                    .hasOwnProperty.call(
                        state.shoppingOverrides,
                        key
                    )
                    ?
                    Number(
                        state.shoppingOverrides[
                            key
                        ]
                    )
                    :
                    automaticallyNeeded;

            return {
                key,
                name: item.name,
                unit: item.unit,
                required:
                    roundQty(item.qty),
                inventory:
                    roundQty(inventoryQty),
                automatic:
                    roundQty(
                        automaticallyNeeded
                    ),
                qty:
                    roundQty(finalQty)
            };

        })
        .filter(item => item.qty > 0.001)
        .sort(
            (a, b) =>
                a.name.localeCompare(b.name)
        );

}


function renderShopping() {

    const container =
