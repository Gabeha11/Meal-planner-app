function addPurchasedToInventory() {

    const list =
        calculateShoppingList();

    const purchased =
        list.filter(
            item =>
                state.shoppingChecked[
                    item.key
                ]
        );

    if (!purchased.length) {

        alert(
            "Check the items you purchased first."
        );

        return;
    }

    purchased.forEach(item => {

        const existing =
            findInventoryItem(
                item.name,
                item.unit
            );

        if (existing) {

            existing.qty =
                roundQty(
                    Number(existing.qty) +
                    Number(item.qty)
                );

        } else {

            state.inventory.push({
                id: uid(),
                name: item.name,
                qty: item.qty,
                unit: item.unit,
                location:
                    guessInventoryLocation(
                        item.name
                    )
            });

        }

    });

    purchased.forEach(item => {

        delete state.shoppingChecked[
            item.key
        ];

        delete state.shoppingOverrides[
            item.key
        ];

    });

    saveState();
    renderAll();

    alert(
        `${purchased.length} purchased item${
            purchased.length === 1
                ? ""
                : "s"
        } added to inventory.`
    );

}


function guessInventoryLocation(
    itemName
) {

    const name =
        normalizeName(itemName);

    const freezerTerms = [
        "frozen"
    ];

    const fridgeTerms = [
        "milk",
        "cream",
        "cheese",
        "butter",
        "lettuce",
        "romaine",
        "broccoli",
        "green bean",
        "egg",
        "sour cream",
        "chicken",
        "beef",
        "pork",
        "tomato"
    ];

    if (
        freezerTerms.some(term =>
            name.includes(term)
        )
    ) {
        return "Freezer";
    }

    if (
        fridgeTerms.some(term =>
            name.includes(term)
        )
    ) {
        return "Refrigerator";
    }

    return "Pantry";

}


/* ============================================================
   COOKING MODE
============================================================ */

function startCooking() {

    const main =
        getTonightMainRecipe();

    if (!main) return;

    const sides =
        getTonightSideRecipes();

    const allRecipes =
        [main, ...sides];

    const maxTime =
        Math.max(
            ...allRecipes.map(
                recipe =>
                    Number(recipe.cookTime) ||
                    recipe.steps.reduce(
                        (total, step) =>
                            total +
                            (Number(
                                step.minutes
                            ) || 0),
                        0
                    )
            )
        );

    const timeline = [];

    allRecipes.forEach(recipe => {

        const recipeDuration =
            Number(recipe.cookTime) ||
            recipe.steps.reduce(
                (total, step) =>
                    total +
                    (Number(
                        step.minutes
                    ) || 0),
                0
            );

        /*
           Start shorter sides later so the meal
           finishes around the same time.
        */

        let minute =
            Math.max(
                0,
                maxTime -
                recipeDuration
            );

        recipe.steps.forEach(
            (step, index) => {

                timeline.push({
                    minute,
                    recipeName:
                        recipe.name,
                    step:
                        step.text,
                    stepNumber:
                        index + 1
                });

                minute +=
                    Number(
                        step.minutes
                    ) || 0;

            }
        );

    });

    timeline.sort(
        (a, b) =>
            a.minute - b.minute
    );

    document.getElementById(
        "cookContent"
    ).innerHTML = `

        <div class="summary-box">

            <strong>
                ${escapeHtml(main.name)}
                ${
                    sides.length
                    ?
                    " + " +
                    sides
                        .map(s =>
                            escapeHtml(s.name)
                        )
                        .join(" + ")
                    :
                    ""
                }
            </strong>

            <div class="muted">
                Approximately ${maxTime} minutes total
            </div>

        </div>

        ${
            main.notes
            ?
            `
                <div class="summary-box" style="margin-top:12px">

                    <strong>
                        Meal Notes
                    </strong>

                    <div style="margin-top:5px">
                        ${escapeHtml(main.notes)}
                    </div>

                </div>
            `
            :
            ""
        }

        <h3 style="margin-top:22px">
            Combined Cooking Timeline
        </h3>

        ${timeline.map(item => `
            <div class="cook-step">

                <div class="cook-time">
                    ${
                        item.minute === 0
                        ? "START"
                        : `+${item.minute} min`
                    }
                </div>

                <strong>
                    ${escapeHtml(item.recipeName)}
                </strong>

                <div>
                    ${escapeHtml(item.step)}
                </div>

            </div>
        `).join("")}

    `;

    openModal("cookModal");

}


/* ============================================================
   BACKUP / RESTORE
============================================================ */

function exportData() {

    const json =
        JSON.stringify(
            state,
            null,
            2
        );

    const blob =
        new Blob(
            [json],
            {
                type:
                    "application/json"
            }
        );

    const url =
        URL.createObjectURL(blob);

    const a =
        document.createElement("a");

    a.href = url;

    a.download =
        "meal-planner-backup.json";

    a.click();

    URL.revokeObjectURL(url);

}


function importData(event) {

    const file =
        event.target.files[0];

    if (!file) return;

    const reader =
        new FileReader();

    reader.onload = function(e) {

        try {

            const imported =
                JSON.parse(
                    e.target.result
                );

            if (
                !Array.isArray(
                    imported.recipes
                ) ||
                !Array.isArray(
                    imported.inventory
                )
            ) {
                throw new Error(
                    "Invalid backup"
                );
            }

            state = imported;

            state.tonight =
                state.tonight || {
                    mainRecipeId: null,
                    servings: 5,
                    sides: []
                };

            state.plan =
                state.plan || {};

            state.shoppingOverrides =
                state.shoppingOverrides ||
                {};

            state.shoppingChecked =
                state.shoppingChecked ||
                {};

            saveState();

            renderAll();

            alert(
                "Meal planner restored successfully."
            );

        } catch (error) {

            alert(
                "That file does not appear to be a valid meal planner backup."
            );

        }

    };

    reader.readAsText(file);

    event.target.value = "";

}


/* ============================================================
   RENDER EVERYTHING
============================================================ */

function renderAll() {

    renderTonight();
    renderRecipes();
    renderInventory();
    renderShopping();
    renderPlan();

}


/* ============================================================
   INITIALIZE
============================================================ */

renderAll();

</script>

