function renderRecipes() {

    const grid =
        document.getElementById("recipeGrid");

    if (!grid) return;

    const query =
        normalizeName(
            document.getElementById(
                "recipeSearch"
            )?.value || ""
        );

    const filter =
        document.getElementById(
            "recipeFilter"
        )?.value || "all";

    const recipes =
        state.recipes.filter(recipe => {

            const matchesQuery =
                !query ||
                normalizeName(recipe.name)
                    .includes(query);

            const matchesFilter =
                filter === "all" ||
                recipe.type === filter;

            return matchesQuery &&
                matchesFilter;

        });

    if (!recipes.length) {

        grid.innerHTML = `
            <div class="card empty-state">
                No recipes found.
            </div>
        `;

        return;
    }

    grid.innerHTML =
        recipes.map(recipe => {

            const coverage =
                getRecipeCoverage(
                    recipe,
                    recipe.servings
                );

            return `
                <div class="card recipe-card">

                    <div class="recipe-title">
                        ${escapeHtml(recipe.name)}
                    </div>

                    <div class="recipe-meta">
                        ${recipe.type === "side"
                            ? "Side"
